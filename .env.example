# AstroSharma Server Environment Variables
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/astrosharma

# JWT Secret for Host Authentication
JWT_SECRET=your_jwt_secret_change_in_production

# Host Default Credentials (Seed on first run)
HOST_USERNAME=your_host_username
HOST_PASSWORD=choose_a_strong_password

# Razorpay Payment Gateway (Optional in Demo Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# LiveKit Server (Optional - Community Edition or Cloud)
# If left blank, AstroSharma falls back automatically to direct WebRTC peer audio via Socket.IO
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Nodemailer / SMTP (Optional for general contact/booking emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=password
SMTP_FROM_EMAIL=user@example.com
ADMIN_EMAIL=admin@example.com
